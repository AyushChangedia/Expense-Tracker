// FluxFin — data model
//
// Money is stored as Decimal(14,2) everywhere. Prisma hands Decimal back as a
// Decimal.js instance, which never survives the server -> client boundary, so
// every query that reaches a client component goes through a serializer in
// src/lib/serialize.ts that converts these to plain numbers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TransactionType {
  INCOME
  EXPENSE
}

/// A category can be restricted to one side of the ledger, or usable by both
/// (e.g. "Other").
enum CategoryKind {
  INCOME
  EXPENSE
  BOTH
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  DANGER
}

// ---------------------------------------------------------------------------
// Auth (Auth.js / NextAuth v5 core models + credentials support)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?

  // Preferences
  currency   String  @default("USD")
  dateFormat String  @default("MMM d, yyyy")
  locale     String  @default("en-US")
  weekStart  Int     @default(0) // 0 = Sunday, 1 = Monday
  onboarded  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts            Account[]
  sessions            Session[]
  categories          Category[]
  transactions        Transaction[]
  tags                Tag[]
  budgets             Budget[]
  goals               Goal[]
  goalContributions   GoalContribution[]
  recurring           RecurringTransaction[]
  notifications       Notification[]
  activities          Activity[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  /// SHA-256 of the token that was emailed; the raw token is never stored.
  tokenHash String    @unique
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Core finance models
// ---------------------------------------------------------------------------

model Category {
  id     String       @id @default(cuid())
  userId String
  name   String
  slug   String
  kind   CategoryKind @default(EXPENSE)

  /// Lucide icon name, resolved through src/lib/categories.ts
  icon         String  @default("Shapes")
  gradientFrom String  @default("#7C3AED")
  gradientTo   String  @default("#38BDF8")
  isDefault    Boolean @default(false)
  isFavorite   Boolean @default(false)
  sortOrder    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  recurring    RecurringTransaction[]

  @@unique([userId, slug])
  @@index([userId, kind])
  @@map("categories")
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  categoryId  String
  type        TransactionType
  amount      Decimal         @db.Decimal(14, 2)
  description String
  notes       String?
  date        DateTime
  isPinned    Boolean         @default(false)

  /// Set when the row was materialised from a recurring rule.
  recurringId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  recurring RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  tags      TransactionTag[]

  @@index([userId, date(sort: Desc)])
  @@index([userId, type, date])
  @@index([userId, categoryId])
  @@index([recurringId])
  @@map("transactions")
}

model Tag {
  id     String @id @default(cuid())
  userId String
  name   String
  slug   String
  color  String @default("#8B5CF6")

  createdAt DateTime @default(now())

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TransactionTag[]

  @@unique([userId, slug])
  @@index([userId])
  @@map("tags")
}

model TransactionTag {
  transactionId String
  tagId         String

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@index([tagId])
  @@map("transaction_tags")
}

model Budget {
  id     String  @id @default(cuid())
  userId String
  /// null = an overall budget covering every expense category that month.
  categoryId String?
  amount     Decimal @db.Decimal(14, 2)
  month      Int // 1-12
  year       Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year])
  @@index([userId, year, month])
  @@map("budgets")
}

model Goal {
  id            String     @id @default(cuid())
  userId        String
  name          String
  targetAmount  Decimal    @db.Decimal(14, 2)
  currentAmount Decimal    @default(0) @db.Decimal(14, 2)
  deadline      DateTime?
  icon          String     @default("Target")
  gradientFrom  String     @default("#7C3AED")
  gradientTo    String     @default("#38BDF8")
  status        GoalStatus @default(ACTIVE)
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@index([userId, status])
  @@map("goals")
}

model GoalContribution {
  id     String   @id @default(cuid())
  goalId String
  userId String
  amount Decimal  @db.Decimal(14, 2)
  date   DateTime @default(now())
  note   String?

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([userId])
  @@map("goal_contributions")
}

model RecurringTransaction {
  id          String              @id @default(cuid())
  userId      String
  categoryId  String
  type        TransactionType
  amount      Decimal             @db.Decimal(14, 2)
  description String
  notes       String?
  frequency   RecurrenceFrequency
  /// Every `interval` units of `frequency` — e.g. interval 2 + WEEKLY = fortnightly.
  interval    Int                 @default(1)
  startDate   DateTime
  endDate     DateTime?
  nextRunDate DateTime
  lastRunDate DateTime?
  isActive    Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@index([userId, isActive])
  @@index([nextRunDate])
  @@map("recurring_transactions")
}

model Notification {
  id      String           @id @default(cuid())
  userId  String
  title   String
  message String
  type    NotificationType @default(INFO)
  href    String?
  read    Boolean          @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Powers the "recent activity" timeline. Deliberately denormalised so the
/// timeline survives deletion of the entity it describes.
model Activity {
  id       String  @id @default(cuid())
  userId   String
  action   String // created | updated | deleted | restored | imported ...
  entity   String // transaction | budget | goal | recurring | category | tag
  entityId String?
  summary  String
  amount   Decimal? @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("activities")
}
