# ---------------------------------------------------------------------------
# Database — a PostgreSQL connection string.
#
# Local:  postgresql://postgres:postgres@localhost:5432/fluxfin?schema=public
# Neon:   postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/fluxfin?sslmode=require
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fluxfin?schema=public"

# ---------------------------------------------------------------------------
# Auth.js — required.
#
# Generate a secret with:  openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-me-with-openssl-rand-base64-32"

# The canonical URL of the deployment. Vercel sets this automatically, so it is
# only needed for local development or a custom host.
AUTH_URL="http://localhost:3000"

# Set to true when running behind a proxy / on Vercel preview URLs.
AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# Google OAuth — optional.
#
# Leave both blank to hide the "Continue with Google" button entirely; the app
# runs fine on email + password alone.
#
# Console: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: {AUTH_URL}/api/auth/callback/google
# ---------------------------------------------------------------------------
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------------------------------------------------------------------------
# Seed credentials — used only by `npm run db:seed`.
# ---------------------------------------------------------------------------
SEED_USER_EMAIL="demo@fluxfin.app"
SEED_USER_PASSWORD="Demo1234!"
